#!/usr/bin/env bash
set -euo pipefail

if ! command -v docker >/dev/null 2>&1; then
    echo "error: docker is required to run pre-commit in the api container" >&2
    exit 1
fi

container_id="$(docker compose ps -q api 2>/dev/null || true)"
if [ -z "$container_id" ]; then
    echo "error: api container is not available. Start it with: docker compose up -d api" >&2
    exit 1
fi

is_running="$(docker inspect -f '{{.State.Running}}' "$container_id" 2>/dev/null || true)"
if [ "$is_running" != "true" ]; then
    echo "error: api container is not running. Start it with: docker compose up -d api" >&2
    exit 1
fi

mapfile -t staged_files < <(git diff --cached --name-only --diff-filter=ACMR)
if [ "${#staged_files[@]}" -eq 0 ]; then
    exit 0
fi

echo "Running pre-commit in Docker (api) on staged files..."
docker compose exec -T api pre-commit run --hook-stage commit --files "${staged_files[@]}"
