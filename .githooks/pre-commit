#!/usr/bin/env bash
set -euo pipefail

if ! command -v docker >/dev/null 2>&1; then
    echo "error: docker is required to run pre-commit in the api container" >&2
    exit 1
fi

container_id=""
remaining=30
attempt=0
while [ "$remaining" -gt 0 ]; do
    attempt=$((attempt + 1))
    cid="$(docker compose ps -q api 2>/dev/null || true)"
    if [ -n "$cid" ] && [ "$(docker inspect -f '{{.State.Running}}' "$cid" 2>/dev/null || true)" = "true" ]; then
        container_id="$cid"
        break
    fi
    if [ "$attempt" -ge 3 ]; then
        any_api="$(docker compose ps -aq api 2>/dev/null || true)"
        if [ -z "$any_api" ]; then
            echo "error: no api container for this compose project. From the repo root: docker compose up -d --wait api" >&2
            exit 1
        fi
    fi
    sleep 1
    remaining=$((remaining - 1))
done

if [ -z "$container_id" ]; then
    exited_id="$(docker compose ps -aq api 2>/dev/null || true)"
    if [ -n "$exited_id" ]; then
        echo "error: api container is not running (it may exit right after start). Last logs:" >&2
        docker compose logs api --tail=40 >&2 || true
        echo "error: Inspect: docker compose ps -a api && docker inspect htmt-api --format '{{.State.Status}} {{.State.ExitCode}}'" >&2
    else
        echo "error: no api container for this compose project. From the repo root: docker compose up -d --wait api" >&2
    fi
    exit 1
fi

mapfile -t staged_files < <(git diff --cached --name-only --diff-filter=ACMR)
if [ "${#staged_files[@]}" -eq 0 ]; then
    exit 0
fi

echo "Running pre-commit in Docker (api) on staged files..."
docker compose exec -T api pre-commit run --hook-stage commit --files "${staged_files[@]}"
