{
  "release_branch": "main",
  "version": {
    "path": "VERSION",
    "format": "text"
  },
  "mirrors": [
    {
      "path": "package.json",
      "format": "json",
      "key": "version"
    },
    {
      "path": "pyproject.toml",
      "format": "toml",
      "key": "project.version"
    },
    {
      "path": "pyproject.toml",
      "format": "toml",
      "key": "tool.bumpversion.current_version"
    }
  ],
  "tag_prefix": "v",
  "changelog": "CHANGELOG.md",
  "outputs": {
    "github_release": true,
    "packages": []
  }
}
