

{
	"yaml.schemas": {
		".vscode/empty-schema.json": [".github/workflows/sync-env-to-server.yml"]
	},
	"files.associations": {
		"**/.github/workflows/publish.yml": "yaml"
	},
    "workbench.colorCustomizations": {
        "editorCursor.foreground": "#2E8B57",
        "terminalCursor.foreground": "#2E8B57",
        "titleBar.activeBackground": "#2E8B57",
        "titleBar.activeForeground": "#ffffff",
        "activityBar.background": "#1d5737",
        "statusBar.background": "#1d5737"
    },
	"python.analysis.typeCheckingMode": "basic",
	"editor.rulers": [
		120
	],
	"python.testing.pytestEnabled": true,
	"python.testing.pytestArgs": [
		"hear/test"
	],
	"python.analysis.autoImportCompletions": true,
	"editor.defaultFormatter": "ms-python.autopep8",
    "editor.formatOnSave": true,
    "python.analysis.fixAll": [
        "source.unusedImports"
      ],
    "editor.codeActionsOnSave": {
		"source.fixAll": "explicit"
	},
	"files.autoSave": "onFocusChange",
	"python.testing.unittestEnabled": false,
	"cursorpyright.analysis.autoImportCompletions": true,
	"cursorpyright.analysis.typeCheckingMode": "basic"
}