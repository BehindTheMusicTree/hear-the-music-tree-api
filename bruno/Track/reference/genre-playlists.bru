meta {
  name: genre-playlists
  type: http
  seq: 1
}

get {
  url: {{BASE_URL}}reference/genre-playlists/
  body: json
  auth: none
}

body:json {
  {
      "username": "{{USERNAME}}",
      "password": "{{PASSWORD}}"
  }
}

vars:post-response {
  jwtAccessToken: res.body.access
  jwtRefreshToken: res.body.refresh
}
