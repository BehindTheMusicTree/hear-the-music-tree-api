meta {
  name: genres-tree-load-example
  type: http
  seq: 3
}

get {
  url: {{BASE_URL}}reference/reference/genres/tree/load-example/
  body: json
  auth: none
}

body:json {
  {
      "username": "{{USERNAME}}",
      "password": "{{PASSWORD}}"
  }
}

vars:post-response {
  jwtAccessToken: res.body.access
  jwtRefreshToken: res.body.refresh
}
