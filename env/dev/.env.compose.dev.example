ENV=dev
APP_NAME=htmt-api
APP_VERSION=2.1.0
APP_TITLE=TheMusicTreeAPI
API_DIR_NAME=api
APP_PORT=8000
DEBUG=true
APP_IS_EXPOSED=false

DATABASE_URL=postgresql://postgres:postgres@db:5432/htmt_api

FILE_UPLOAD_ENABLED=true
TMP_UPLOADED_FILES=/tmp/uploaded-files/
METADATA_SESSION_DIR=/tmp/metadata-sessions/
MEDIA_DIR=/tmp/htmt-media
LIBRARIES_DIR=/tmp/htmt-media/libraries

DJANGO_LOG_DIR=/var/log/django/
DJANGO_LOG_GENERAL_FILENAME=general.log
DJANGO_LOG_INFO_FILENAME=info.log
DJANGO_LOG_REQUESTS_FILENAME=requests.log
DJANGO_LOG_REQUESTS_DEBUG_FILENAME=requests.debug.log
DJANGO_LOG_EXCEPTIONS_FILENAME=exceptions.log
DJANGO_LOG_DJANGO_FILENAME=django.log
DJANGO_LOG_APP_FILENAME=app.log
GUNICORN_LOG_DIR=/var/log/gunicorn/
GUNICORN_LOG_ERROR_FILENAME=error.log
GUNICORN_LOG_ACCESS_FILENAME=access.log
# When true (default in docker-compose.yml api service), start-server sends Gunicorn access/error to stdout/stderr for docker compose logs; false uses the paths above.
GUNICORN_STDOUT_LOGS=true

STATIC_FILES_URL=/static/

AFP_ENABLED=true
AFP_URL=afp
AFP_PORT=7015
AFP_POST_ENDPOINT=fingerprint-audio
AFP_IMAGE_REPO=audio-fingerprinter
AFP_VERSION=v1.4.4
GHCR_IMAGE_NAMESPACE=behindthemusictree

MUSICBRAINZ_LOOKUP_ENABLED=true
ACOUSTID_API_KEY=dev-acoustid-key
SPOTIFY_ENABLED=true
SPOTIFY_CLIENT_ID=dev-spotify-client-id
SPOTIFY_CLIENT_SECRET=dev-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:9002/auth/spotify/callback
SPOTIFY_SCOPES=user-read-email
GOOGLE_OAUTH_ENABLED=true
GOOGLE_CLIENT_ID=dev-google-client-id
GOOGLE_CLIENT_SECRET=dev-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:9002/auth/google/callback

TMTA_USERNAME=tmta
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=superadmin
SUPERADMIN_EMAIL=superadmin@example.com
DEMO_USERNAME=demo
DEMO_PASSWORD=demo
DEMO_EMAIL=demo@example.com
