ENV=DEV

APP_NAME=htmt-api
APP_TITLE="TheMusicTreeAPI"
APP_VERSION=1.0.4
API_DIR_NAME=api

DOCKERHUB_USERNAME=mignot

DEBUG=true
APP_IS_EXPOSED=false

TMP_UPLOADED_FILES_INTERNAL=tmp-uploaded-files/
AUDIO_META_ANALYSIS_ENABLED=true
ACOUSTID_API_KEY='***'

MEDIA_DIR_INTERNAL=media/
LIBRARIES_DIR_NAME=libraries

STATIC_FILES_INTERNAL=static-files/

DJANGO_LOG_DIR_INTERNAL=log/
DJANGO_LOG_GENERAL_FILENAME=general.log
DJANGO_LOG_INFO_FILENAME=info.log
DJANGO_LOG_REQUESTS_FILENAME=requests.log
DJANGO_LOG_REQUESTS_DEBUG_FILENAME=requests.debug.log
DJANGO_LOG_EXCEPTIONS_FILENAME=exceptions.log
DJANGO_LOG_DJANGO_FILENAME=django.log
DJANGO_LOG_APP_FILENAME=app.log

DB_IS_NEEDED=true
DB_DATA_MUST_PERSIST=true
DB_CONTAINER_NAME=DB
DB_IMAGE_REPO=bodzify-db-postgres
DB_VERSION=v1.0.0
DB_DATA_DIR=/var/lib/postgresql/data/
DB_SUPERUSER_NAME=postgres
DB_SUPERUSER_PASSWORD='***'
DB_APP_DB_NAME=***
DB_APP_USERNAME=***
DB_APP_USER_PASSWORD='***'
DB_URL=localhost
DB_PORT=5432

AFP_CONTAINER_NAME=AFP
AFP_URL=localhost
AFP_IMAGE_REPO=bodzify-audio-fingerprinter-flask
AFP_VERSION=v1.0.0
AFP_POOL_DIR_EXTERNAL=/tmp/pool/
AFP_PORT=7015
AFP_POST_ENDPOINT=fingerprint-audio

SPOTIFY_ENABLED=true
SPOTIFY_CLIENT_ID=***
SPOTIFY_CLIENT_SECRET=***
# Must match exactly: (1) Redirect URIs in Spotify Developer Dashboard, (2) frontend callback URL used in auth request
SPOTIFY_REDIRECT_URI=http://127.0.0.1:9002/auth/spotify/callback
SPOTIFY_SCOPES="user-read-email playlist-read-private playlist-read-collaborative user-library-read user-top-read"

GOOGLE_OAUTH_ENABLED=true
GOOGLE_CLIENT_ID=***
GOOGLE_CLIENT_SECRET=***
# Must match exactly the redirect URI used by the frontend (e.g. origin + /auth/google/callback)
GOOGLE_REDIRECT_URI=http://127.0.0.1:9002/auth/google/callback

MUSICBRAINZ_LOOKUP_ENABLED=true

TMTA_USERNAME=***

SUPERADMIN_USERNAME=***
SUPERADMIN_PASSWORD=***
SUPERADMIN_EMAIL=garcia.andreas.1991@gmail.com

DEMO_USERNAME=***
DEMO_PASSWORD=***
DEMO_EMAIL=demo@themusictree.org
